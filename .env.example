# Used by docker-compose.yml (copy to .env)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=work_management

# Backend CORS: JSON array of allowed origins
CORS_ORIGINS=["https://app.yourdomain.com"]

# Baked into the frontend build (client-side, must be publicly reachable)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Google Calendar sync (see README for Google Cloud setup steps)
FRONTEND_URL=https://app.yourdomain.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/v1/calendar/google/callback
